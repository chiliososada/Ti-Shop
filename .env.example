# Public origin used by Better Auth, same-origin checks (including the image
# upload endpoint), canonical URLs, and payment callbacks. Production must use
# the exact customer-facing HTTPS origin and must not include a path.
SITE_URL=http://localhost:3000

# Generic PostgreSQL 17 connections. These placeholders do not point to
# Supabase. For local host development, POSTGRES_HOST may be 127.0.0.1; from a
# Docker container it must be a hostname reachable from that container.
DATABASE_URL="postgresql://APP_RUNTIME_USER:REPLACE_ME@POSTGRES_HOST:5432/ti_shop?schema=app&sslmode=verify-full"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800

# Privileged connection used only by Prisma migration, seed, legacy import,
# and explicit owner-grant jobs. Do not inject it into the long-running app.
DIRECT_URL="postgresql://MIGRATION_USER:REPLACE_ME@POSTGRES_HOST:5432/ti_shop?schema=app&sslmode=verify-full"

# Generate a unique value for each environment with `openssl rand -base64 48`.
# Production rejects empty, short, low-diversity, and placeholder values.
BETTER_AUTH_SECRET=

# Leave both values empty when the app is not behind the repository's trusted
# reverse proxy; Better Auth then uses one shared fail-closed rate-limit bucket
# instead of trusting spoofable client headers. When enabled, the origin must
# be private and the proxy must overwrite this header.
AUTH_CLIENT_IP_HEADER=
AUTH_TRUSTED_PROXY_CIDRS=

# NOWPayments stays fail-closed until deliberately enabled in both runtime
# configuration and the admin payment controls. `mock` is forbidden when
# NODE_ENV=production. Sandbox requires the current official HTTPS /v1 URL.
# Never expose any of these values through NEXT_PUBLIC_* variables.
NOWPAYMENTS_MODE=disabled
NOWPAYMENTS_API_BASE_URL=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_TIMEOUT_MS=10000

# Product image object storage (Supabase Storage over its S3-compatible API).
# Fail-closed: while any value is missing, image uploads are disabled and the
# admin UI explains why; existing images keep working. All values are
# server-side only — never expose them through NEXT_PUBLIC_* variables, and
# keep the access key pair out of source control and logs. See
# docs/storage.md for setup, rotation, and recovery procedures.
#
# Supabase examples (values come from the project dashboard):
#   STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   STORAGE_S3_REGION=<project region, e.g. ca-central-1>
#   STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/product-images
# Local development uses a disposable MinIO container instead; http:// is
# accepted only for loopback hosts and always rejected in production.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET_PRODUCT_IMAGES=product-images
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
# Optional tuning (defaults shown).
#STORAGE_S3_FORCE_PATH_STYLE=true
#STORAGE_REQUEST_TIMEOUT_MS=15000
#PRODUCT_IMAGE_MAX_BYTES=10485760
#PRODUCT_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif
