model PaymentMethodConfig {
  id                  BigInt        @id @default(autoincrement())
  method              PaymentMethod @unique(map: "payment_method_configs_method_key")
  displayName         String        @map("display_name") @db.VarChar(160)
  isEnabled           Boolean       @default(false) @map("is_enabled")
  publicInstructions  String?       @map("public_instructions") @db.Text
  credentialEnvPrefix String?       @map("credential_env_prefix") @db.VarChar(120)
  settingKey          String?       @map("setting_key") @db.VarChar(160)
  updatedByUserId     String?       @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  setting             SiteSetting?  @relation(fields: [settingKey], references: [key], onDelete: SetNull, map: "payment_method_configs_setting_key_fkey")
  updatedBy           User?         @relation("PaymentMethodConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "payment_method_configs_user_id_fkey")

  @@index([settingKey], map: "payment_method_configs_setting_key_idx")
  @@index([updatedByUserId], map: "payment_method_configs_user_id_idx")
  @@map("payment_method_configs")
  @@schema("app")
}

model Payment {
  id                      BigInt               @id @default(autoincrement())
  publicId                String               @unique(map: "payments_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  orderId                 BigInt               @map("order_id")
  idempotencyKey          String?              @unique(map: "payments_idempotency_key_key") @map("idempotency_key") @db.VarChar(160)
  method                  PaymentMethod
  status                  PaymentStatus        @default(CREATED)
  currency                String               @default("USD") @db.Char(3)
  amountMinor             BigInt               @map("amount_minor")
  cryptoCurrency          String?              @map("crypto_currency") @db.VarChar(20)
  cryptoAmount            Decimal?             @map("crypto_amount") @db.Decimal(36, 18)
  exchangeRate            Decimal?             @map("exchange_rate") @db.Decimal(36, 18)
  actuallyPaid            Decimal?             @map("actually_paid") @db.Decimal(36, 18)
  outcomeAmount           Decimal?             @map("outcome_amount") @db.Decimal(36, 18)
  outcomeCurrency         String?              @map("outcome_currency") @db.VarChar(20)
  providerPaymentId       String?              @unique(map: "payments_provider_payment_id_key") @map("provider_payment_id") @db.VarChar(255)
  providerInvoiceId       String?              @unique(map: "payments_provider_invoice_id_key") @map("provider_invoice_id") @db.VarChar(255)
  providerPurchaseId      String?              @map("provider_purchase_id") @db.VarChar(255)
  parentProviderPaymentId String?              @map("parent_provider_payment_id") @db.VarChar(255)
  providerStatus          String?              @map("provider_status") @db.VarChar(120)
  payAddress              String?              @map("pay_address") @db.Text
  payExtraId              String?              @map("pay_extra_id") @db.Text
  checkoutUrl             String?              @map("checkout_url") @db.Text
  expiresAt               DateTime?            @map("expires_at") @db.Timestamptz(3)
  confirmedAt             DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  failedAt                DateTime?            @map("failed_at") @db.Timestamptz(3)
  canceledAt              DateTime?            @map("canceled_at") @db.Timestamptz(3)
  metadata                Json?
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                   Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "payments_order_id_fkey")
  events                  PaymentEvent[]
  manualProofs            ManualPaymentProof[]
  internalNotes           InternalNote[]
  financialAdjustments    FinancialAdjustment[]   @relation("AdjustmentPayment")
  conversionEntries       CryptoConversionEntry[] @relation("ConversionEntryPayment")

  @@index([orderId, createdAt], map: "payments_order_created_at_idx")
  @@index([status, createdAt], map: "payments_status_created_at_idx")
  @@index([method, status], map: "payments_method_status_idx")
  @@index([providerPurchaseId], map: "payments_provider_purchase_id_idx")
  @@index([parentProviderPaymentId], map: "payments_parent_provider_payment_id_idx")
  @@map("payments")
  @@schema("app")
}

model PaymentEvent {
  id              BigInt         @id @default(autoincrement())
  publicId        String         @unique(map: "payment_events_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  paymentId       BigInt         @map("payment_id")
  providerEventId String?        @unique(map: "payment_events_provider_event_id_key") @map("provider_event_id") @db.VarChar(255)
  eventType       String         @map("event_type") @db.VarChar(160)
  statusBefore    PaymentStatus? @map("status_before")
  statusAfter     PaymentStatus? @map("status_after")
  amountMinor     BigInt?        @map("amount_minor")
  cryptoAmount    Decimal?       @map("crypto_amount") @db.Decimal(36, 18)
  rawPayload      Json?          @map("raw_payload")
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "payment_events_payment_id_fkey")

  @@index([paymentId, occurredAt], map: "payment_events_payment_time_idx")
  @@index([eventType, occurredAt], map: "payment_events_type_time_idx")
  @@map("payment_events")
  @@schema("app")
}

model ManualPaymentProof {
  id                BigInt                   @id @default(autoincrement())
  publicId          String                   @unique(map: "manual_payment_proofs_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  paymentId         BigInt                   @map("payment_id")
  mediaId           BigInt?                  @map("media_id")
  submittedByUserId String?                  @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId  String?                  @map("reviewed_by_user_id") @db.Uuid
  referenceNumber   String?                  @map("reference_number") @db.VarChar(255)
  amountMinor       BigInt                   @map("amount_minor")
  currency          String                   @default("USD") @db.Char(3)
  note              String?                  @db.Text
  status            ManualPaymentProofStatus @default(PENDING)
  reviewedAt        DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?                  @map("review_note") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment           Payment                  @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "manual_payment_proofs_payment_id_fkey")
  media             Media?                   @relation(fields: [mediaId], references: [id], onDelete: SetNull, map: "manual_payment_proofs_media_id_fkey")
  submittedBy       User?                    @relation("PaymentProofSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull, map: "manual_payment_proofs_submitter_id_fkey")
  reviewedBy        User?                    @relation("PaymentProofReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, map: "manual_payment_proofs_reviewer_id_fkey")

  @@index([paymentId, status, createdAt], map: "manual_payment_proofs_payment_idx")
  @@index([mediaId], map: "manual_payment_proofs_media_id_idx")
  @@index([submittedByUserId], map: "manual_payment_proofs_submitter_idx")
  @@index([reviewedByUserId], map: "manual_payment_proofs_reviewer_idx")
  @@map("manual_payment_proofs")
  @@schema("app")
}
