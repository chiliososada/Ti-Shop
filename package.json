{
  "name": "veripep-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:seo": "node scripts/verify-production.mjs",
    "test:watch": "vitest",
    "assets:products": "node scripts/generate-veripep-product-images.mjs",
    "media:backfill-dimensions": "tsx scripts/backfill-local-media-dimensions.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import:legacy": "tsx scripts/import-legacy-commerce.ts",
    "db:studio": "prisma studio",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "admin:verify-email": "tsx scripts/verify-user-email.ts",
    "inventory:expire-reservations": "NODE_OPTIONS=--conditions=react-server tsx scripts/expire-inventory-reservations.ts",
    "payments:reconcile:nowpayments": "NODE_OPTIONS=--conditions=react-server tsx scripts/reconcile-nowpayments.ts",
    "storage:process-outbox": "NODE_OPTIONS=--conditions=react-server tsx scripts/process-storage-outbox.ts",
    "storage:scan-orphans": "NODE_OPTIONS=--conditions=react-server tsx scripts/scan-storage-orphans.ts",
    "security:cleanup-rate-limits": "NODE_OPTIONS=--conditions=react-server tsx scripts/cleanup-rate-limits.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1086.0",
    "@aws-sdk/s3-request-presigner": "3.1086.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.23",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.16"
  },
  "allowScripts": {
    "@prisma/client@7.8.0": true,
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.3": true
  }
}
